{
  "name": "dsh-stage-chat",
  "version": "0.1.7",
  "description": "阶段式对话视图：按执行过程、执行结果与待确认事项组织一轮回复",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "src", "vendor", "scripts", "tests", "tsconfig.json", "cordis.patch.yml", "dsh-stage-chat-config.json", "dsh-stage-chat-output-prompt.md", "README.md", "README.en.md", "LICENSE", "LICENSE-APACHE-2.0.txt", "THIRD_PARTY_NOTICES.md"],
  "engines": {"node": ">=20", "dsh": "<=0.2.2-rc.5"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "install:dev": "node scripts/install-dev.mjs",
    "uninstall:dev": "node scripts/uninstall-dev.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "peerDependencies": {"@deepseek-ai/cordis": "~4.1.0"},
  "dependencies": {"@deepseek-ai/schemastery": "~3.19.0"},
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "clsx": "^2.0.0",
    "simple-icons": "16.31.0",
    "shiki": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@deepseek-ai/dsh-util-code-language": "0.2.2-rc.5",
    "anser": "^2.3.5",
    "diff": "^9.0.0",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-gfm": "^3.0.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.0",
    "micromark-util-character": "^2.0.0",
    "micromark-util-classify-character": "^2.0.0",
    "micromark-util-symbol": "^2.0.0",
    "micromark-factory-space": "^2.0.0",
    "micromark-util-decode-string": "^2.0.0",
    "micromark-util-sanitize-uri": "^2.0.0",
    "katex": "0.18.7",
    "zustand": "^5.0.0",
    "immer": "^10.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
